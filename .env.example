# Required for AI panel stylization. Leave blank and set SKIP_STYLIZATION=true
# to test the complete pipeline with photographic panels.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium

# Optional. Without this key, the app uses deterministic heuristic beat scoring.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME=Video Comic MVP

# Local transcription
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# MVP controls
MAX_VIDEO_SECONDS=120
MAX_PANELS=6
SKIP_STYLIZATION=false
WORK_DIR=./var/jobs
